#!/usr/bin/env bash
# bin/dev — local dev stack (DEV-1..5). Plain bash.
#
#   bin/dev            foreground; Ctrl-C tears down
#   bin/dev -d         detached (setsid, pgid in tmp/dev.pid, log in tmp/dev.log)
#   bin/dev --stop     stop the detached stack
#   bin/dev --status   running or not, with pgid and ports
#
# dev.local.env (gitignored, optional) is sourced first. Set UI_HOST there to
# listen on another address, such as a LAN IP. See dev.local.env.example.
#
# Two processes: `para serve --vault dev` under air (rebuilds on .go saves, API
# only, 127.0.0.1:API_PORT) and Vite (HMR, UI_HOST:UI_PORT). Vite proxies every
# server path and sends the API's own Host and Origin, so POSTs pass the gate.
# State lives in tmp/dev-home (PARA_HOME) with one vault, `dev`, made on first
# run. It never touches ~/.para. The sign-in link with the admin token is
# printed once the server answers. Through the proxy a remote browser looks
# local to the gate, so the admin token works from your laptop in dev only.
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f dev.local.env ] && . ./dev.local.env

API_PORT="${API_PORT:-7700}"   # para serve
UI_PORT=$((API_PORT + 1))      # DEV-2
UI_HOST="${UI_HOST:-127.0.0.1}"
export API_PORT UI_PORT UI_HOST

PIDFILE=tmp/dev.pid
LOG=tmp/dev.log
export PARA_HOME="$PWD/tmp/dev-home"
DEV_VAULT_DIR="$PWD/tmp/dev-vault"
AIR_BIN=.air/para-dev

running() { [ -f "$PIDFILE" ] && kill -0 -- "-$(cat "$PIDFILE")" 2>/dev/null; }

free_port() { # DEV-3
  local pids
  pids="$(lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null || true)"
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
  sleep 0.3
  pids="$(lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -n "$pids" ]; then kill -9 $pids 2>/dev/null || true; fi
}

need() { # DEV-8: print the install line, never sudo
  command -v "$1" >/dev/null 2>&1 && return 0
  case "$(uname -s)" in
    Linux)  echo "bin/dev: missing '$1' — install: sudo apt install -y $2" >&2 ;;
    Darwin) echo "bin/dev: missing '$1' — install: brew install $3" >&2 ;;
    *)      echo "bin/dev: missing '$1'" >&2 ;;
  esac
  exit 1
}

stop() {
  if running; then
    local pgid; pgid="$(cat "$PIDFILE")"
    echo "==> stopping dev stack (pgid $pgid)" >&2
    kill -- "-$pgid" 2>/dev/null || true
    for _ in $(seq 1 50); do kill -0 -- "-$pgid" 2>/dev/null || break; sleep 0.1; done
    if kill -0 -- "-$pgid" 2>/dev/null; then kill -9 -- "-$pgid" 2>/dev/null || true; fi
  else
    echo "==> dev stack: not running" >&2
  fi
  rm -f "$PIDFILE"
  free_port "$UI_PORT"
  free_port "$API_PORT"
}

detach=0 child=0
for arg in "$@"; do
  case "$arg" in
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -d|--detach|--detatch) detach=1 ;;
    --run) child=1 ;;
    --stop) stop; exit 0 ;;
    --status)
      if running; then echo "running (pgid $(cat "$PIDFILE"))  ui $UI_HOST:$UI_PORT  api 127.0.0.1:$API_PORT"
      else echo "not running  (ui :$UI_PORT)"; fi
      exit 0 ;;
    *) echo "bin/dev: unknown option '$arg'" >&2; exit 2 ;;
  esac
done

mkdir -p tmp
if [ "$child" = 0 ]; then
  running && { echo "bin/dev: already running; --stop first" >&2; exit 1; }
  need node nodejs node
  need pnpm '' pnpm
  command -v air >/dev/null 2>&1 || { echo "bin/dev: missing 'air' — install: go install github.com/air-verse/air@latest" >&2; exit 1; }
  need go golang go
  need lsof lsof lsof
  need setsid util-linux util-linux
  echo "==> ui http://$UI_HOST:$UI_PORT (vite)  api 127.0.0.1:$API_PORT (para serve --vault dev, air)  home $PARA_HOME" >&2
  [ -d "$PARA_HOME/vaults/dev" ] && echo "==> dev vault: already set up" >&2 || echo "==> dev vault: will be created at $DEV_VAULT_DIR with sample items" >&2
fi

if [ "$detach" = 1 ]; then # DEV-4
  setsid bash "$0" --run >"$LOG" 2>&1 </dev/null &
  for _ in $(seq 1 20); do running && break; sleep 0.2; done
  running || { echo "bin/dev: failed to start; see $LOG" >&2; exit 1; }
  echo "==> detached (pgid $(cat "$PIDFILE"))  logs: tail -f $LOG  stop: bin/dev --stop" >&2
  exit 0
fi

ps -o pgid= -p $$ | tr -d ' ' > "$PIDFILE"
free_port "$UI_PORT"
free_port "$API_PORT"

# First run: a throwaway vault with a few items, so every screen has something.
if [ ! -d "$PARA_HOME/vaults/dev" ]; then
  mkdir -p "$PARA_HOME" .air
  go build -o .air/para-seed ./cmd/para
  .air/para-seed init dev "$DEV_VAULT_DIR" --no-git >/dev/null
  P=".air/para-seed --vault dev"
  id() { sed -n 's/.*"id": *"\([^"]*\)".*/\1/p' | head -1; }
  $P inbox add "Ask platform about the staging quota" >/dev/null
  $P inbox add "Renew the VPN certificate" >/dev/null
  proj="$($P project add "Launch the pilot" --owner me --json | id)"
  t1="$($P task add "Write the rollout plan" -p "$proj" --json | id)"
  $P task add "Get the quota approved" -p "$proj" --depends-on "$t1" >/dev/null
  $P org person add "Sam Rivera" --org Acme >/dev/null 2>&1 || true
  rm -f .air/para-seed
fi

cd ui
[ -d node_modules ] || pnpm install # DEV-6

cleanup() {
  trap - EXIT INT TERM
  rm -f "../$PIDFILE"
  kill "$vite" "$air" 2>/dev/null || true
  for _ in $(seq 1 30); do
    kill -0 "$vite" 2>/dev/null || kill -0 "$air" 2>/dev/null || exit 0
    sleep 0.1
  done
  kill -9 "$vite" "$air" 2>/dev/null || true
  exit 0
}
# Both run in the background so a signal reaches this trap at once; bash runs a
# trap only after a foreground child exits. Only these two are signalled: `kill 0`
# would also hit a parent shell in the same process group.
cd ..
air -c .air.toml \
  --build.cmd "go build -o $AIR_BIN ./cmd/para" \
  --build.entrypoint "$AIR_BIN" \
  --build.args_bin "serve,--vault,dev,--addr,127.0.0.1:$API_PORT" </dev/null &
air=$!
cd ui
pnpm gen >/dev/null
node_modules/.bin/vite </dev/null &
vite=$!
trap cleanup EXIT INT TERM

# Print the sign-in link once the server answers (the token file exists after its first start).
(
  for _ in $(seq 1 120); do
    # Through Vite, so both the proxy and the server answer.
    curl -fsS "http://$UI_HOST:$UI_PORT/healthz" >/dev/null 2>&1 && break
    sleep 0.5
  done
  cd ..
  echo "==> sign in: $(.air/para-dev service login-admin --vault dev --print --url "http://$UI_HOST:$UI_PORT" 2>&1 | tail -1)"
) &
wait "$vite" "$air"
