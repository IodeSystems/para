#!/usr/bin/env bash
# bin/deps — the single dependency-upgrade entry point (X-DEPS-1).
# Latest compatible, no forced majors. Renovate still opens per-dep PRs.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> go get -u ./... && go mod tidy" >&2
go get -u ./...
go mod tidy

for d in ui; do
  [ -f "$d/package.json" ] || continue
  echo "==> $d: pnpm update" >&2
  (cd "$d" && pnpm update)
done

echo "==> diff" >&2
git --no-pager diff --stat -- go.mod go.sum ui/package.json ui/pnpm-lock.yaml
